# Environment Variables Template for Local Development
# Copy this file to each service directory and rename to .env

# ========================================
# Auth Service Environment Variables
# ========================================

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/svh_auth_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver

# JWT Configuration
JWT_SECRET=your-development-secret-key-change-in-production-minimum-256-bits
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# Server Configuration
SERVER_PORT=8081
SERVER_SERVLET_CONTEXT_PATH=/api

# Logging
LOG_LEVEL=DEBUG

# CORS Configuration
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Eureka (Service Discovery)
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false

# Mail Configuration (for email verification - optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@svh.com

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760

# Application Profile
SPRING_PROFILES_ACTIVE=development

